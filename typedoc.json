{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "assets/**/*.json",
    "src/components/*.ts",
    "src/config.ts",
    "src/constants.ts",
    "src/dialogs/*.ts",
    "src/features/index.ts",
    "src/interface.ts",
    "src/observers.ts",
    "src/siteEvents.ts",
    "src/types.ts",
    "src/utils/broadcast.ts",
    "src/utils/index.ts",
  ],
  "excludeTags": [
    "@override",
    "@virtual",
    "@privateRemarks",
    "@satisfies",
    "@overload",
    "@inline",
    "@inlineType",
    "@see",
  ],
  "plugin": ["typedoc-plugin-markdown"],
  "out": "docs/typedocs/",
  "skipErrorChecking": true
}
